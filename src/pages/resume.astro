---
import Layout from '~/layouts/Layout.astro'
import resume from '~/data/resume.json' with { type: 'json' }

const { basics, summary, experience, projects, skills, education } = resume
---

<Layout title="Resume" description={`${basics.name} - ${basics.headline}`}>
  <div class="resume max-w-3xl mx-auto">
    
    <!-- Header -->
    <header class="mt-8 mb-8">
      <h1 class="text-3xl font-bold">{basics.name}</h1>
      <p class="text-lg text-foreground/70 mt-1">{basics.headline}</p>
      {
        basics.website && (
          <p class="text-sm text-foreground/60 mt-1">
            <a href={basics.website} class="hover:text-accent">{basics.website_label || basics.website}</a>
          </p>
        )
      }
    </header>

    <!-- Summary -->
    {
      summary && (
        <section class="mb-6">
          <p class="text-foreground/80 leading-relaxed">{summary}</p>
        </section>
      )
    }

    <!-- Experience -->
    {
      experience.length > 0 && (
        <section class="mb-6">
          <h2 class="text-lg font-semibold border-b border-accent/20 pb-1 mb-3">工作经历</h2>
          {experience.map((exp) => (
            <div class="mb-4">
              <div class="flex justify-between items-baseline">
                <h3 class="font-semibold">{exp.company}</h3>
              </div>
              <p class="text-sm text-foreground/60">{exp.position}</p>
              {exp.intro && <p class="text-sm text-foreground/60 mb-1">{exp.intro}</p>}
              {
                exp.details.length > 0 && (
                  <ul class="list-disc list-inside text-sm text-foreground/70 space-y-0.5">
                    {exp.details.map((d) => <li>{d}</li>)}
                  </ul>
                )
              }
            </div>
          ))}
        </section>
      )
    }

    <!-- Projects -->
    {
      projects.length > 0 && (
        <section class="mb-6">
          <h2 class="text-lg font-semibold border-b border-accent/20 pb-1 mb-3">项目经历</h2>
          {projects.map((proj) => (
            <div class="mb-3">
              <h3 class="font-semibold">{proj.name}</h3>
              {proj.intro && <p class="text-sm text-foreground/70 mb-1">{proj.intro}</p>}
              {
                proj.details.length > 0 && (
                  <ul class="list-disc list-inside text-sm text-foreground/70 space-y-0.5">
                    {proj.details.map((d) => <li>{d}</li>)}
                  </ul>
                )
              }
            </div>
          ))}
        </section>
      )
    }

    <!-- Skills -->
    {
      skills.length > 0 && (
        <section class="mb-6">
          <h2 class="text-lg font-semibold border-b border-accent/20 pb-1 mb-3">技能</h2>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-foreground/70">
            {skills.map((s) => <span>{s}</span>)}
          </div>
        </section>
      )
    }

    <!-- Education -->
    {
      education.length > 0 && (
        <section class="mb-6">
          <h2 class="text-lg font-semibold border-b border-accent/20 pb-1 mb-3">教育经历</h2>
          {education.map((edu) => (
            <div class="mb-2">
              <h3 class="font-semibold text-sm">{edu.school}</h3>
              <p class="text-sm text-foreground/60">{edu.degree} · {edu.field}</p>
            </div>
          ))}
        </section>
      )
    }

  </div>
</Layout>

<style>
  @media print {
    header, nav, footer, .giscus { display: none !important; }
    .resume { max-width: 100% !important; }
    body { font-size: 11px; }
  }
</style>
