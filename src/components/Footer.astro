---
import SocialLinks from '~/components/SocialLinks.astro'
import type { FooterConfig } from '~/types'

interface Props {
  footer?: FooterConfig
}

const { footer } = Astro.props

const isEnabled = footer?.enabled ?? true
const socialLinks = (footer?.socialLinks ?? []).filter((link) => link.enabled !== false)
const showCopyright = footer?.showCopyright ?? false
const copyrightText = footer?.copyrightText ?? ''

const hasContent = socialLinks.length > 0 || (showCopyright && copyrightText)
---

{
  isEnabled && hasContent && (
    <footer class="mt-auto pt-9 md:pt-11 grow-0 flex flex-col gap-6 items-center justify-between max-w-full text-foreground/80">
      {socialLinks.length > 0 && <SocialLinks links={socialLinks} />}
      {showCopyright && copyrightText && <span class="my-1">{copyrightText}</span>}
    </footer>
  )
}