---
import type { FooterSocialLink } from '~/types'
import IconGithub from '~/icons/github.svg'
import IconMastodon from '~/icons/mastodon.svg'
import IconX from '~/icons/x.svg'
import IconLinkedin from '~/icons/linkedin.svg'
import IconBluesky from '~/icons/bluesky.svg'
import IconEmail from '~/icons/email.svg'
import IconRss from '~/icons/rss.svg'

interface Props {
  links: Array<FooterSocialLink>
}

const { links } = Astro.props

// 图标名 → 组件映射。后台在「设置 → 页脚 → 社交链接 → 图标」里选择。
const iconMap = {
  github: IconGithub,
  x: IconX,
  twitter: IconX,
  rss: IconRss,
  email: IconEmail,
  linkedin: IconLinkedin,
  bluesky: IconBluesky,
  mastodon: IconMastodon,
} as const

type IconName = keyof typeof iconMap

function resolveIcon(icon?: string) {
  if (!icon) return null
  const key = icon.toLowerCase() as IconName
  return iconMap[key] ?? null
}

// 邮箱类链接自动补 mailto:
function resolveHref(url: string, icon?: string) {
  if (icon?.toLowerCase() === 'email' && !url.startsWith('mailto:')) {
    return `mailto:${url}`
  }
  return url
}

const isExternal = (url: string) => /^https?:\/\//i.test(url)

const resolved = links
  .map((link) => ({ ...link, Icon: resolveIcon(link.icon), href: resolveHref(link.url, link.icon) }))
  .filter((link) => link.Icon !== null)
---

{
  resolved.length > 0 && (
    <div class="flex w-full max-w-md items-center justify-between">
      {resolved.map(({ name, href, Icon }) => (
        <a
          href={href}
          target={isExternal(href) ? '_blank' : undefined}
          rel={isExternal(href) ? 'noopener noreferrer' : undefined}
          class="social-link"
        >
          <span class="sr-only">{name}</span>
          {Icon && <Icon class="size-7" />}
        </a>
      ))}
    </div>
  )
}